{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "swiftcart-69c08",
          "appId": "1:877619186510:android:21c52e371c98688fe66c1f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "swiftcart-69c08",
          "configurations": {
            "android": "1:877619186510:android:21c52e371c98688fe66c1f",
            "ios": "1:877619186510:ios:5ecd9591b11013a0e66c1f",
            "macos": "1:877619186510:ios:5ecd9591b11013a0e66c1f",
            "web": "1:877619186510:web:f3c42939648903cde66c1f",
            "windows": "1:877619186510:web:3ba91e4fa7e1dde0e66c1f"
          }
        }
      }
    }
  },

  "functions": {
    "source": "functions",
    "codebase": "default",
    "runtime": "nodejs20"
    // "region": "us-central1" // Set this in your function definition, not here.
  },

  "firestore": {
    "rules": "firestore.rules"
  },

  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/test/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(css|js|woff2|woff|ttf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "errorPage": "404.html"
  },

  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
