rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Admins: Only authenticated admins may read/write their own doc =====
    match /admins/{adminId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true && request.auth.uid == adminId;
    }

    // ===== Malls =====
    match /malls/{mallId} {
      // Anyone can read public mall info
      allow read: if true;
      // Only authenticated admins or designated mall managers can modify
      allow create, update, delete: if request.auth != null && (
          request.auth.token.admin == true ||
          request.auth.token.manager_mall_id == mallId
        );

      // ===== Products =====
      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.token.admin == true ||
          request.auth.token.manager_mall_id == mallId
        );
      }

      // ===== Barcodes =====
      match /barcodes/{barcodeId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.token.admin == true ||
          request.auth.token.manager_mall_id == mallId
        );
      }

      // ===== Payments & Bills (checkout data) =====
      match /payments/{paymentId}, /bills/{billId} {
        allow read, write: if request.auth != null && (
          request.auth.token.admin == true ||
          request.auth.token.manager_mall_id == mallId
        );
      }

      // ===== Managers (for this mall) =====
      match /managers/{managerId} {
        allow read: if request.auth != null && (
          request.auth.token.admin == true ||
          request.auth.token.manager_mall_id == mallId
        );
        allow write: if request.auth != null && request.auth.token.admin == true;
      }

      // ===== Promotions =====
      match /promotions/{promotionId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.token.admin == true ||
          request.auth.token.manager_mall_id == mallId
        );
      }

      // ===== Staff Activity =====
      match /staff_activity/{activityId} {
        allow read, write: if request.auth != null && (
          request.auth.token.admin == true ||
          request.auth.token.manager_mall_id == mallId
        );
      }
    }

    // ===== Mall subscriptions: Only admins ====
    match /mall_subscriptions/{subId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // ===== Managers and Manager Index: Admins only =====
    match /managers/{managerId}, /manager_index/{managerIdxId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // ===== Announcements (public read, admin post only) =====
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if false;
    }

    // ===== Support requests (users create/see their own) =====
    match /support_requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }

    // ===== Users: Can only access/change own profile & subcollections =====
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Allow user to view and store their own bills/payments.
      match /bills/{billId}, /payments/{paymentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ===== OTP and password reset (for signup/recovery flows) =====
    match /email_otp_signup/{otpId}, /phone_otp/{otpId}, /password_reset_otp/{otpId} {
      allow read, write: if true; // Consider restricting by request time or caller if possible
    }

    // ===== Read-only collections for catalog/info =====
    match /barcodes/{barcodeId}, /bills/{billId}, /products/{productId}, /promotions/{promotionId}, /staff_activity/{activityId} {
      allow read: if true;
      allow write: if false;
    }

    // ===== For testing only: never allow in prod =====
    match /_test/{docId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // ===== Default deny all =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
